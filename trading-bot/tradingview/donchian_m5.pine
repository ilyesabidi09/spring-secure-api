//@version=5
// =====================================================================
// Donchian M5 Breakout — MNQ (Nasdaq futures) — Tradeify
// Params VALIDES sur VRAIES donnees CME (Databento GLBX.MDP3, 2 ans) :
//   walk-forward 4/4 (+3565, 111 trades), holdout reproductible +432 / PF 1.19.
//   Edge REEL mais MODESTE (PF ~1.2). Momentum only ; mean-reversion echoue ici.
//
// UTILISATION (forward-test) :
//   1. Colle dans Pine Editor.
//   2. Chart en 5 MINUTES, symbole MNQ1! (ou NQ1! = meme prix).
//   3. "Add to chart" -> Strategy Tester. Un label orange s'affiche si tu n'es
//      pas en 5 min.
//   4. Pour trader : alertes -> pont (TradersPost/PickMyTrade) -> Tradeify,
//      ou manuel / paper trading.
//
// ATTENTION : edge fin -> pas de sur-trading. Regime 2024-26 = haussier ; se
// mefier en marche baissier/choppy. Regles de compte Tradeify (trailing 2000,
// daily loss, consistency) NON simulees ici -> a gerer via le pont / manuellement.
// =====================================================================
strategy("Donchian M5 Breakout - MNQ", overlay=true,
     initial_capital=50000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.75,
     slippage=1, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=true)

// ---------- Inputs (defaults = params valides sur vrai MNQ) ----------
channelPeriod = input.int(18,   "Donchian channel (barres)")
adxPeriod     = input.int(14,   "ADX / DI period")
adxMin        = input.float(19.97,"ADX minimum (filtre tendance)")
atrPeriod     = input.int(14,   "ATR period")
atrStopMult   = input.float(1.40,"Stop = x * ATR")
rrRatio       = input.float(2.99,"Target = R:R * stop")
riskUSD       = input.float(75.0,"Risque par trade (USD)")
maxContracts  = input.int(5,    "Contrats max")
pointValue    = input.float(2.0, "USD par point (MNQ=2, NQ=20)")
useSession    = input.bool(true, "Filtre session RTH uniquement")
sess          = input.session("0930-1600", "Session RTH")

// ---------- Indicateurs ----------
upper = ta.highest(high, channelPeriod)[1]   // canal des barres PRECEDENTES
lower = ta.lowest(low,  channelPeriod)[1]
atr   = ta.atr(atrPeriod)
[diP, diM, adx] = ta.dmi(adxPeriod, adxPeriod)
// Session en heure de New York (comme le backtest Python), PAS l'heure d'echange CME.
inSess = not useSession or not na(time(timeframe.period, sess, "America/New_York"))

// Avertissement si le chart n'est pas en 5 minutes.
if barstate.islast and timeframe.period != "5"
    label.new(bar_index, high, "⚠ Passe le chart en 5 minutes (strategie M5)",
         color=color.orange, style=label.style_label_down, textcolor=color.white)

// ---------- Sizing base sur le risque ----------
stopPts = atrStopMult * atr
riskPerContract = stopPts * pointValue
qty = math.min(maxContracts, math.max(1, math.floor(riskUSD / riskPerContract)))

// ---------- Entrees ----------
flat      = strategy.position_size == 0
longCond  = close > upper and adx > adxMin and inSess and flat
shortCond = close < lower and adx > adxMin and inSess and flat

var float slPrice = na
var float tpPrice = na

if longCond
    strategy.entry("Long", strategy.long, qty=qty)
    slPrice := close - stopPts
    tpPrice := close + stopPts * rrRatio
    alert("LONG " + syminfo.ticker, alert.freq_once_per_bar_close)
if shortCond
    strategy.entry("Short", strategy.short, qty=qty)
    slPrice := close + stopPts
    tpPrice := close - stopPts * rrRatio
    alert("SHORT " + syminfo.ticker, alert.freq_once_per_bar_close)

// ---------- Sorties bracket (stop / target figes a l'entree) ----------
if strategy.position_size > 0
    strategy.exit("L-exit", "Long",  stop=slPrice, limit=tpPrice)
if strategy.position_size < 0
    strategy.exit("S-exit", "Short", stop=slPrice, limit=tpPrice)

// ---------- Visuel ----------
plot(upper, "Donchian haut", color=color.new(color.teal, 40))
plot(lower, "Donchian bas",  color=color.new(color.red, 40))
